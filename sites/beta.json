				{
					"fontFamily": "Figtree",
					"fontStretch": "normal",
					"fontStyle": "normal",
					"fontWeight": "300 900",
					"src": ["file:./assets/fonts/Figtree-VariableFont_wght.ttf"]
				},
				{
					"fontFamily": "Figtree",
					"fontStretch": "normal",
					"fontStyle": "italic",
					"fontWeight": "300 900",
					"src": ["file:./assets/fonts/Figtree-Italic-VariableFont_wght.ttf"]
				}
			]
		}
	},
	"logo": "assets/images/logo-beta.svg",
	"footerLogo": "assets/images/logo-beta.svg"
}
