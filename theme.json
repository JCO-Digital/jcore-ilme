{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"border": {},
		"color": {
			"defaultPalette": false,
			"custom": false,
			"defaultGradients": false,
			"customGradient": false,
			"defaultDuotone": false,
			"palette": [
				{
					"color": "#0e313f",
					"name": "Brand",
					"slug": "brand"
				},
				{
					"color": "#0e313f",
					"name": "Brand dark",
					"slug": "brand-dark"
				},
				{
					"color": "#081d25",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#fafafa",
					"name": "Accent contrast",
					"slug": "accent-contrast"
				},
				{
					"color": "#f0f6f7",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#ffffff",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#fafafa",
					"name": "Light",
					"slug": "light"
				},
				{
					"color": "#081d25",
					"name": "Dark",
					"slug": "dark"
				},
				{
					"color": "#323b45",
					"name": "Dark lighter",
					"slug": "dark-lighter"
				},
				{
					"color": "#000000",
					"name": "Black",
					"slug": "black"
				},
				{
					"color": "#52A728",
					"name": "Success",
					"slug": "success"
				},
				{
					"color": "#FFC107",
					"name": "Warning",
					"slug": "warning"
				},
				{
					"color": "#DE1D1D",
					"name": "Failure",
					"slug": "failure"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(to right, var(--wp--preset--color--white), var(--wp--preset--color--brand))",
					"name": "White to Brand",
					"slug": "white-to-brand"
				},
				{
					"gradient": "linear-gradient(124deg, var(--wp--preset--color--brand) 17.8%, color-mix(in srgb, var(--wp--preset--color--brand) 78%, #000) 37.25%, color-mix(in srgb, var(--wp--preset--color--brand) 90%, #000) 68.1%, var(--wp--preset--color--brand) 87.56%)",
					"name": "CTA",
					"slug": "cta"
				}
			]
		},
		"custom": {
			"pullquote": {
				"markOffset": "-0.05em"
			},
			"lineHeight": {
				"xs": "1.1",
				"sm": "1.2",
				"md": "1.3",
				"lg": "1.5",
				"paragraph": "1.333",
				"ingress": "1.4"
			},
			"spacingSizes": {
				"small": "clamp(.5rem, 3.7vw + -0.05rem,  1rem)",
				"medium": "clamp(1rem, 3.7vw + -0.05rem,  2rem )",
				"large": "clamp(1.5rem, 3.7vw + -0.05rem,  3rem )",
				"xlarge": "clamp(2.5rem, 3.7vw + -0.05rem,  4.5rem )"
			},
			"ruudukko": {
				"gap": "var(--wp--preset--spacing--fluid-medium)"
			},
			"radius": {
				"s": "16px",
				"m": "24px",
				"button": "32px"
			},
			"button": {
				"hover": {
					"primary": "#45c445",
					"primaryText": "var(--wp--preset--color--dark)",
					"secondary": "#45c445",
					"secondaryText": "var(--wp--preset--color--dark)"
				}
			}
		},
		"dimensions": {
			"minHeight": true
		},
		"layout": {
			"contentSize": "min(872px, 90vw)",
			"wideSize": "min(1324px, 90vw)"
		},
		"position": {},
		"shadow": {},
		"spacing": {
			"blockGap": null,
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Fluid small",
					"size": "var:custom|spacing-sizes|small",
					"slug": "fluid-small"
				},
				{
					"name": "Fluid medium",
					"size": "var:custom|spacing-sizes|medium",
					"slug": "fluid-medium"
				},
				{
					"name": "Fluid large",
					"size": "var:custom|spacing-sizes|large",
					"slug": "fluid-large"
				},
				{
					"name": "Fluid extralarge",
					"size": "var:custom|spacing-sizes|xlarge",
					"slug": "fluid-xlarge"
				}
			]
		},
		"typography": {
			"fluid": {
				"minViewportWidth": "1024px",
				"maxViewportWidth": "1920px"
			},
			"lineHeight": false,
			"letterSpacing": false,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Rethink Sans",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"src": ["file:./assets/fonts/RethinkSans-VariableFont_wght.ttf"]
						},
						{
							"fontFamily": "Rethink Sans",
							"fontStretch": "normal",
							"fontStyle": "italic",
							"fontWeight": "400 800",
							"src": ["file:./assets/fonts/RethinkSans-Italic-VariableFont_wght.ttf"]
						}
					],
					"fontFamily": "\"Rethink Sans\", sans-serif",
					"name": "Heading",
					"slug": "heading"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"src": ["file:./assets/fonts/Inter.woff2"]
						}
					],
					"fontFamily": "\"Inter\", sans-serif",
					"name": "Inter",
					"slug": "inter"
				}
			],
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"name": "Paragraph",
					"slug": "paragraph",
					"size": "18px",
					"fluid": false
				},
				{
					"name": "H1",
					"slug": "heading-1",
					"size": "52px",
					"fluid": {
						"min": "36px",
						"max": "52px"
					}
				},
				{
					"name": "H2",
					"slug": "heading-2",
					"size": "36px",
					"fluid": {
						"min": "28px",
						"max": "36px"
					}
				},
				{
					"name": "H3",
					"slug": "heading-3",
					"size": "28px",
					"fluid": {
						"min": "22px",
						"max": "28px"
					}
				},
				{
					"name": "H4",
					"slug": "heading-4",
					"size": "22px",
					"fluid": false
				},
				{
					"name": "H5",
					"slug": "heading-5",
					"size": "20px",
					"fluid": false
				},
				{
					"name": "H6",
					"slug": "heading-6",
					"size": "20px",
					"fluid": false
				},
				{
					"name": "Ingress",
					"slug": "ingress",
					"size": "20px",
					"fluid": {
						"min": "18px",
						"max": "20px"
					}
				},
				{
					"name": "Button",
					"slug": "button",
					"size": "16px",
					"fluid": false
				},
				{
					"fluid": false,
					"name": "Small",
					"slug": "small",
					"size": "16px"
				},
				{
					"fluid": false,
					"name": "Mini",
					"slug": "mini",
					"size": "14px"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true,
		"blocks": {
			"core/pullquote": {
				"border": {
					"color": true,
					"radius": true,
					"style": true,
					"width": true
				}
			},
			"core/image": {
				"lightbox": {
					"enabled": false,
					"allowEditing": true
				}
			}
		}
	},
	"styles": {
		"spacing": {
			"padding": {
				"left": "var:custom|spacing-sizes|medium",
				"right": "var:custom|spacing-sizes|medium"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var:preset|font-size|paragraph",
			"lineHeight": "var:custom|line-height|paragraph"
		},
		"color": {
			"text": "var:preset|color|dark",
			"background": "var:preset|color|white"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600"
				},
				"color": {
					"text": "var:preset|color|dark"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-1",
					"lineHeight": "1.077",
					"fontWeight": "600",
					"letterSpacing": "-0.4px"
				},
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "1.5rem"
					}
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-2",
					"lineHeight": "1.222",
					"fontWeight": "600",
					"letterSpacing": "0"
				},
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "1rem"
					}
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-3",
					"lineHeight": "1.214",
					"fontWeight": "600",
					"letterSpacing": "-0.4px"
				},
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "var:custom|spacing-sizes|small"
					}
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-4",
					"lineHeight": "1.455",
					"fontWeight": "600",
					"letterSpacing": "0"
				},
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "var:custom|spacing-sizes|small"
					}
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-5",
					"lineHeight": "1.2",
					"fontWeight": "600",
					"letterSpacing": "0"
				},
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "var:custom|spacing-sizes|small"
					}
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-6",
					"lineHeight": "1.2",
					"fontWeight": "600",
					"letterSpacing": "0"
				},
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "var:custom|spacing-sizes|small"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|dark"
				},
				"typography": {
					"fontSize": "var:preset|font-size|mini",
					"letterSpacing": "1px"
				},
				"spacing": {
					"margin": {
						"bottom": "0px"
					}
				}
			},
			"link": {
				"typography": {
					"textDecoration": "underline",
					"fontWeight": "600"
				},
				"color": {
					"text": "var:preset|color|brand"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|brand"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"bottom": "var:custom|spacing-sizes|medium",
						"top": "0"
					}
				}
			},
			"core/group": {
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "var:custom|spacing-sizes|medium"
					},
					"padding": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "var:custom|spacing-sizes|medium",
						"left": "var:custom|spacing-sizes|medium",
						"right": "var:custom|spacing-sizes|medium"
					}
				}
			},
			"core/cover": {
				"dimensions": {
					"minHeight": "50vh"
				}
			},
			"core/gallery": {
				"spacing": {
					"margin": {
						"top": "var:custom|spacing-sizes|medium",
						"bottom": "var:custom|spacing-sizes|medium"
					}
				}
			},
			"core/image": {
				"spacing": {
					"margin": {
						"bottom": "var:custom|spacing-sizes|medium"
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var:preset|font-size|heading-1"
				}
			},
			"core/buttons": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "1.5rem",
						"left": "0",
						"right": "0"
					}
				}
			},
			"core/button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|accent-contrast"
				},
				"border": {
					"radius": "var:custom|radius|button",
					"color": "var:preset|color|accent",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontSize": "var:preset|font-size|button",
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "400",
					"lineHeight": "1.375"
				},
				"spacing": {
					"padding": {
						"top": "17px",
						"bottom": "17px",
						"left": "29px",
						"right": "29px"
					},
					"margin": {
						"top": "0",
						"bottom": ".5rem",
						"left": "0",
						"right": ".5rem"
					}
				},
				"shadow": "0px 0px 0px 0px var(--wp--preset--color--dark)",
				"variations": {
					"outline": {
						"color": {
							"background": "var:preset|color|surface",
							"text": "var:preset|color|dark"
						},
						"border": {
							"radius": "var:custom|radius|button",
							"color": "var:preset|color|surface",
							"style": "solid",
							"width": "1px"
						},
						"typography": {
							"fontSize": "var:preset|font-size|button",
							"fontFamily": "var:preset|font-family|heading",
							"textTransform": "none",
							"fontWeight": "400",
							"lineHeight": "1.375"
						},
						"spacing": {
							"padding": {
								"top": "17px",
								"bottom": "17px",
								"left": "29px",
								"right": "29px"
							},
							"margin": {
								"top": "0",
								"bottom": ".5rem",
								"left": "0",
								"right": ".5rem"
							}
						},
						"shadow": "0px 0px 0px 0px var(--wp--preset--color--dark)"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--brand)"
				}
			},
			"core/table": {
				"css": "color: var(--wp--preset--color--brand) & th{ background: var(--wp--preset--color--light)"
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-headless",
			"title": "Page (no header or footer)",
			"postTypes": ["page"]
		},
		{
			"name": "page-no-hero",
			"title": "Page without hero",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "navigation",
			"title": "Navigation",
			"area": "header"
		},
		{
			"name": "cover",
			"title": "Cover",
			"area": "uncategorized"
		},
		{
			"name": "hero-plain",
			"title": "Hero: page title and excerpt",
			"area": "uncategorized"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"patterns": []
}
