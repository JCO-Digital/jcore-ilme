<header {{ wrapper_attributes }} data-jscroll data-jsticky>
	<nav id="jcore-nav">
		{% block navbar %}
			{% block logo %}
				<div class="brand">
					{% include 'images/navbar-brand.twig' %}
				</div>
			{% endblock %}
			{% block menu %}
				{% include "navigation/menu.twig" with {items: menu.primary.get_items, id: "jcore-menu", level: 0} only %}
			{% endblock %}
			{% block search %}
				<button id="searchbar-toggle" class="toggle-search mr-4 mr-lg-0" data-jtoggle="#menu-searchbar">
					<i class="fas fa-search"></i>
				</button>
			{% endblock %}
			<button class="hamburger" data-jtoggle="#jcore-menu" data-class="mobile-open">
				{% include "images/hamburger.twig" %}
			</button>
		{% endblock %}
	</nav>
</header>
